---
import '../styles/global.css';
import { site } from '../site';

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/books', label: 'Books' },
  { href: '/blog', label: 'Blog' },
];

// Mark the current section so the nav underlines where you are.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,200..600;1,6..72,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />

    {
      /* Visit counting. Only in the built site, and only once a code is set,
         so local development is never counted. is:inline keeps Astro from
         bundling this third-party script. */
      import.meta.env.PROD && site.goatcounter && (
        <script
          is:inline
          data-goatcounter={`https://${site.goatcounter}.goatcounter.com/count`}
          async
          src="//gc.zgo.at/count.js"
        />
      )
    }
  </head>

  <body>
    <div class="page">
      <header>
        <a href="/" class="logo">LAASYA</a>

        <div class="header-right">
          <nav class="nav-links">
            {
              navItems.map((item) => (
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              ))
            }
          </nav>

          <div class="header-divider"></div>

          <nav class="socials">
            <a href={site.x} target="_blank" rel="noopener noreferrer">X</a>
            <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          </nav>
        </div>
      </header>

      <main>
        <slot />
      </main>

      <footer>
        <span>&copy; {new Date().getFullYear()} Laasya</span>
        <span>{site.footer}</span>
      </footer>
    </div>

    <script>
      // Links written in the Markdown content that point to other sites open in a new tab.
      document.querySelectorAll<HTMLAnchorElement>('.prose a[href^="http"]').forEach((link) => {
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
      });

      // Small, intentionally subtle entrance animation
      document.addEventListener('DOMContentLoaded', () => {
        const elements = document.querySelectorAll('[data-animate]');

        elements.forEach((element, index) => {
          element.animate(
            [
              { opacity: 0, transform: 'translateY(18px)' },
              { opacity: 1, transform: 'translateY(0)' },
            ],
            {
              duration: 700,
              delay: index * 120,
              easing: 'cubic-bezier(.2,.7,.2,1)',
              fill: 'both',
            }
          );
        });
      });
    </script>
  </body>
</html>
