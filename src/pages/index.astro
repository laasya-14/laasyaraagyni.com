---
// The words on this page come from content/home.md.
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const home = await getEntry('home', 'home');
if (!home) throw new Error('content/home.md is missing');
const { Content } = await render(home);
const page = home.data;
---

<BaseLayout title={page.name}>
  <section class="hero">
    <div class="hero-text" data-animate>
      <div class="eyebrow">{page.eyebrow}</div>

      <h1>{page.name}</h1>

      <p class="intro">{page.intro}</p>
    </div>

    <div class="portrait-container">
      <picture>
        <source srcset="/portrait.webp" type="image/webp" />
        <img
          src="/portrait.png"
          alt={page.portrait_alt}
          class="portrait"
          width="1086"
          height="1448"
          data-animate
        />
      </picture>
    </div>
  </section>

  <section class="section about" data-animate>
    <div class="section-label">{page.section_label}</div>

    <div class="rule"></div>

    <div class="prose">
      <Content />

      {
        page.ps && (
          <p class="ps">
            <em>{page.ps}</em>
          </p>
        )
      }
    </div>
  </section>
</BaseLayout>
