---
import BaseLayout from '../layouts/BaseLayout.astro';
import { X_URL, LINKEDIN_URL } from '../site';
---

<BaseLayout title="Laasya">
  <section class="hero">
    <div class="hero-text" data-animate>
      <div class="eyebrow">About me</div>

      <h1>Laasya</h1>

      <p class="intro">
        Software developer, curious about science, sports and books.
      </p>
    </div>

    <div class="portrait-container">
      <picture>
        <source srcset="/portrait.webp" type="image/webp" />
        <img
          src="/portrait.png"
          alt="A pencil drawing of a girl, made by Laasya"
          class="portrait"
          width="1400"
          height="1945"
          data-animate
        />
      </picture>
    </div>
  </section>

  <section class="section about" data-animate>
    <div class="section-label">A little more</div>

    <div class="rule"></div>

    <div class="prose">
      <p>
        I&rsquo;m a software developer by profession, with a soft spot for science and astronomy.
        It&rsquo;s something I&rsquo;d like to eventually dive a little deeper into.
      </p>

      <p>
        If you spot me outside, I&rsquo;m probably doing something sports- or fitness-related.
        Otherwise, I&rsquo;m usually reading with a cup of coffee.
      </p>

      <p>
        Currently reading <em>The Vegetarian</em> by Han Kang. More on the <a href="/books">books</a> page.
      </p>

      <p>
        Feel free to say hello on <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer"
          >LinkedIn</a
        >, or on <a href={X_URL} target="_blank" rel="noopener noreferrer">X</a>, where I post my
        views, random musings, and anything I find interesting.
      </p>

      <p class="ps">
        <em>
          P.S. I drew this picture on the side back in school. I&rsquo;d like to find my way back to
          it sometime.
        </em>
      </p>
    </div>
  </section>
</BaseLayout>
