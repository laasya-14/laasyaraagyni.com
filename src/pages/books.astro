---
// The books on this page come from content/books.md. A book with its own
// page in content/books/ links to it.
import BaseLayout from '../layouts/BaseLayout.astro';
import BookEntry from '../components/BookEntry.astro';
import { getBooks } from '../books';

const { intro, reading, finished } = await getBooks();
---

<BaseLayout
  title="Books · Laasya"
  description="What I'm reading and what I've read."
>
  <div class="page-head" data-animate>
    <h2 class="page-title">Books</h2>
    <p class="page-intro">{intro}</p>
  </div>

  <section data-animate>
    <div class="section-label">Currently reading</div>
    <div class="rule"></div>

    <ul class="entry-list">
      {
        reading.map((book) => <BookEntry book={book} />)
      }
    </ul>
  </section>

  <section class="section" data-animate>
    <div class="section-label">Read</div>
    <div class="rule"></div>

    {
      finished.length === 0 ? (
        <p class="empty-note">Still building this list.</p>
      ) : (
        <ul class="entry-list">
          {finished.map((book) => (
            <BookEntry book={book} />
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
