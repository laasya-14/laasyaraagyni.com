---
// The books on this page come from content/books.md.
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const books = await getEntry('books', 'books');
if (!books) throw new Error('content/books.md is missing');
const { intro, reading, finished } = books.data;
---

<BaseLayout
  title="Books · Laasya"
  description="What I'm reading and what I've read."
>
  <div class="page-head" data-animate>
    <h2 class="page-title">Books</h2>
    <p class="page-intro">{intro}</p>
  </div>

  <section data-animate>
    <div class="section-label">Currently reading</div>
    <div class="rule"></div>

    <ul class="entry-list">
      {
        reading.map((book) => (
          <li class="entry">
            <div>
              <span class="entry-title">{book.title}</span>
              <span class="entry-meta">{book.author}</span>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" data-animate>
    <div class="section-label">Read</div>
    <div class="rule"></div>

    {
      finished.length === 0 ? (
        <p class="empty-note">Still building this list.</p>
      ) : (
        <ul class="entry-list">
          {finished.map((book) => (
            <li class="entry">
              <div>
                <span class="entry-title">{book.title}</span>
                <span class="entry-meta">
                  {book.author}
                  {book.year ? ` · ${book.year}` : ''}
                </span>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
