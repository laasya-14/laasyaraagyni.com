---
// Scratch page for choosing the display font. Not linked in the nav.
// Once you pick one, tell me the name and I'll set --display in global.css
// and delete this page.
const candidates = [
  { name: 'Newsreader', stack: "'Newsreader', Georgia, serif", note: 'Current pick. Editorial, made for screens.' },
  { name: 'Fraunces', stack: "'Fraunces', Georgia, serif", note: 'Warm and slightly hand-drawn. Most character.' },
  { name: 'Instrument Serif', stack: "'Instrument Serif', Georgia, serif", note: 'Very elegant, high contrast, minimal.' },
  { name: 'EB Garamond', stack: "'EB Garamond', Georgia, serif", note: 'Classic old-style book face. Quiet.' },
  { name: 'Libre Baskerville', stack: "'Libre Baskerville', Georgia, serif", note: 'Sturdy and traditional.' },
  { name: 'Cormorant Garamond', stack: "'Cormorant Garamond', Georgia, serif", note: 'Delicate and fine-lined.' },
  { name: 'Lora', stack: "'Lora', Georgia, serif", note: 'Soft, calm, unfussy.' },
  { name: 'DM Serif Display', stack: "'DM Serif Display', Georgia, serif", note: 'Bold and confident.' },
  { name: 'Playfair Display', stack: "'Playfair Display', Georgia, serif", note: 'What you had before, for reference.' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pick a font</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=DM+Sans:wght@400;500&family=DM+Serif+Display&family=EB+Garamond:wght@400;500&family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Instrument+Serif&family=Libre+Baskerville&family=Lora:wght@400;500&family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Playfair+Display:wght@400;500&family=Source+Serif+4:opsz,wght@8..60,400&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --background: #f7f6f2;
        --text: #171717;
        --muted: #77736c;
        --line: #d8d5ce;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        font-family: 'DM Sans', sans-serif;
        padding: 50px 55px 90px;
      }
      .lede {
        font-size: 14px;
        color: var(--muted);
        max-width: 620px;
        line-height: 1.6;
        margin: 0 0 60px;
      }
      .sample {
        border-top: 1px solid var(--line);
        padding: 44px 0 10px;
      }
      .tag {
        font-size: 11px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 22px;
        display: flex;
        gap: 14px;
        align-items: baseline;
        flex-wrap: wrap;
      }
      .tag b {
        color: var(--text);
        letter-spacing: 0.16em;
      }
      .tag span {
        letter-spacing: 0;
        text-transform: none;
        font-size: 12px;
      }
      .name {
        font-size: 76px;
        line-height: 1;
        font-weight: 400;
        letter-spacing: -0.02em;
        margin: 0 0 26px;
      }
      .intro {
        font-size: 25px;
        line-height: 1.45;
        max-width: 460px;
        margin: 0;
      }
      .body {
        font-family: 'Source Serif 4', Georgia, serif;
        font-size: 20px;
        line-height: 1.68;
        max-width: 620px;
        margin: 26px 0 0;
        color: #333;
      }
    </style>
  </head>
  <body>
    <p class="lede">
      Each block below is your real home page text set in a different display font. The paragraph
      underneath is the body face (Source Serif 4) so you can see the pairing. Tell me the name of
      the one you like and I'll set it everywhere.
    </p>

    {
      candidates.map((f) => (
        <div class="sample">
          <div class="tag">
            <b>{f.name}</b>
            <span>{f.note}</span>
          </div>
          <p class="name" style={`font-family: ${f.stack}`}>Laasya</p>
          <p class="intro" style={`font-family: ${f.stack}`}>
            Software developer, curious about science, sports and books.
          </p>
          <p class="body">
            I&rsquo;m a software developer by profession, with a soft spot for science and astronomy.
            It&rsquo;s something I&rsquo;d like to eventually dive a little deeper into.
          </p>
        </div>
      ))
    }
  </body>
</html>
